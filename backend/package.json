{
  "name": "mithilakart-backend",
  "version": "0.1.0",
  "description": "Mithilakart API — Phase 10 production hardening",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --testPathIgnorePatterns=tests/layer2",
    "test:watch": "jest --watch --runInBand",
    "test:integration": "jest --runInBand tests/integration",
    "test:e2e": "jest --runInBand tests/integration --json --outputFile=test-reports/e2e-results.json",
    "lint": "eslint src tests --ext .js",
    "load-test": "k6 run load-tests/catalog-search.k6.js",
    "validate:env": "node scripts/validate-env.js",
    "generate:jwt-keys": "node scripts/generate-jwt-keys.js",
    "seed:auth": "node scripts/seed-auth.js",
    "seed:catalog": "node scripts/seed-catalog.js",
    "seed:phase3": "node scripts/migrate-phase3.js",
    "migrate:cr001": "node scripts/migrate-cr001.js",
    "migrate:cr002": "node scripts/migrate-cr002.js",
    "seed:sellers": "node scripts/seed-sellers.js",
    "test:layer2": "jest --runInBand tests/layer2",
    "seed:cr002-test": "node scripts/seed-cr002-test-data.js",
    "migrate:idempotency-unique": "node scripts/migrate-idempotency-unique.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mithilakart",
    "ecommerce",
    "api"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0"
  }
}
