# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1

# MongoDB (required)
MONGODB_URI=mongodb://localhost:27017/mithilakart

# Redis (required for auth/session/OTP)
REDIS_URL=redis://localhost:6379

# Auth
EXPOSE_OTP_IN_DEV=false
SEED_ADMIN_PASSWORD=Admin@12345
SEED_SELLER_PASSWORD=Seller@12345

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Upload (local disk — Phase 0 only)
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
UPLOAD_DESTINATION=uploads

# CORS (comma-separated origins in production)
CORS_ORIGIN=http://localhost:5173

# Rate limiting & metrics (Phase 10)
RATE_LIMIT_ENABLED=true
METRICS_ENABLED=true
CACHE_SEARCH_TTL_SECONDS=120

# CDN (optional — prepends to relative asset paths)
# CDN_BASE_URL=https://cdn.example.com

# Graceful shutdown (ms)
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# JWT keys — run: node scripts/generate-jwt-keys.js
# Keys are loaded from backend/keys/{portal}-private.pem by default
# ---------------------------------------------------------------------------

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=keys/firebase-service-account.json

# SMS — SMS India Hub
SMS_PROVIDER=smsindiahub
SMS_API_KEY=
SMS_SENDER_ID=
SMS_ENTITY_ID=
SMS_DLT_TEMPLATE_ID=
SMS_OTP_TEMPLATE="Welcome to ##var## Powered by IIDMTB. Use OTP ##var## to verify your login."
SMS_OTP_BRAND_NAME=Mithilakart
SMS_CHANNEL=Trans
SMS_GATEWAY_URL=https://cloud.smsindiahub.in/api/mt/SendSMS
SMS_FORCE_SEND=false
