# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1

# MongoDB (required)
MONGODB_URI=mongodb://localhost:27017/mithilakart

# Redis (required for auth/session/OTP)
REDIS_URL=redis://localhost:6379

# Auth
EXPOSE_OTP_IN_DEV=false
# Optional, comma-separated. Exempts specific "countryCode:phone" identifiers
# from OtpService's send-rate-limit (5/hour) ONLY — for E2E test fixtures that
# would otherwise share a real customer's budget across test runs. HARD FORCED
# to empty under NODE_ENV=production no matter what this is set to (see
# config/index.js) — never put a real customer's number here regardless.
OTP_SEND_LIMIT_BYPASS_PHONES=
# Optional. Shared secret an E2E test harness sends as header
# X-E2E-Test-Token to skip ONLY the authLogin rate-limit rule (10/15min) —
# every other rule (public/authenticated/admin/upload/reportExport) is still
# enforced. HARD FORCED to null under NODE_ENV=production regardless of this
# value (see config/index.js). Generate a random value per environment; never
# reuse a value across environments.
E2E_TEST_TOKEN=
SEED_ADMIN_PASSWORD=Admin@12345
SEED_SELLER_PASSWORD=Seller@12345

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Upload (local disk — Phase 0 only)
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
UPLOAD_DESTINATION=uploads

# CORS (comma-separated origins in production)
# NOTE: `localhost` and `127.0.0.1` are DISTINCT origins to a browser even
# though they resolve to the same machine — include both forms for every dev
# port you actually use, or requests from one will be silently CORS-rejected.
# This project's real frontend runs on port 3000 (see frontend/vite.config.js).
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting & metrics (Phase 10)
RATE_LIMIT_ENABLED=true
METRICS_ENABLED=true
CACHE_SEARCH_TTL_SECONDS=120

# CDN (optional — prepends to relative asset paths)
# CDN_BASE_URL=https://cdn.example.com

# Graceful shutdown (ms)
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# JWT keys — run: node scripts/generate-jwt-keys.js
# Keys are loaded from backend/keys/{portal}-private.pem by default
# ---------------------------------------------------------------------------

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# REQUIRED for webhook-driven payment confirmation to function at all.
# Configure in the Razorpay dashboard under Webhooks; use the exact secret
# shown there. Leaving this unset means every incoming webhook is rejected
# (fails closed — see PaymentService.handleRazorpayWebhook).
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_CHANNEL_ID=
# REQUIRED for the Shiprocket status webhook to accept anything at all.
# Configure a custom secret token in the Shiprocket dashboard's webhook
# settings, then set the identical value here. Leaving this unset means
# every webhook is REJECTED (fails closed — see
# ShiprocketClient.verifyWebhookToken). Before the 2026-08-25 production
# readiness audit this instead accepted every request unauthenticated when
# unset — a real security gap, now fixed.
SHIPROCKET_WEBHOOK_SECRET=

# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=keys/firebase-service-account.json

# SMS — SMS India Hub
SMS_PROVIDER=smsindiahub
SMS_API_KEY=
SMS_SENDER_ID=
SMS_ENTITY_ID=
SMS_DLT_TEMPLATE_ID=
SMS_OTP_TEMPLATE="Welcome to ##var## Powered by IIDMTB. Use OTP ##var## to verify your login."
SMS_OTP_BRAND_NAME=Mithilakart
SMS_CHANNEL=Trans
SMS_GATEWAY_URL=https://cloud.smsindiahub.in/api/mt/SendSMS
SMS_FORCE_SEND=false
